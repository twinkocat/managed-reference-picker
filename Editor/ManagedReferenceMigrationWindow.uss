.migration-window {
    flex-grow: 1;
    padding: 8px;
}

.migration-title {
    -unity-font-style: bold;
    font-size: 16px;
    margin-bottom: 8px;
}

.migration-description {
    white-space: normal;
    margin-bottom: 6px;
}

.migration-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.migration-results {
    flex-grow: 1;
}

.migration-entry {
    padding: 8px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #777777;
}
